{
	# Required for on_demand_tls: Caddy calls this before issuing/renewing a cert for any
	# hostname it doesn't already have static config for, and only proceeds on a 200 — see
	# GET /api/internal/tls-ask in src/supervisor/supervisor.ts. That endpoint only responds on
	# Host localhost/127.0.0.1 (exactly what this "ask" URL sends), specifically so the same path
	# under a tenant's own domain reaches their app instead of being shadowed by this check.
	on_demand_tls {
		ask http://localhost:11005/api/internal/tls-ask
	}
}

# Wildcard site block: matches every hostname (SNI) that isn't claimed by a more specific block
# below. `tls { on_demand }` is explicit here rather than relying on Caddy's implicit behavior for
# host-less addresses, since that's changed across Caddy versions — safer to state it directly.
#
# Proxies to Varnish (deploy/varnish/), not directly to the supervisor — Varnish forwards
# everything it can't/shouldn't cache straight through to the supervisor's own :11005 as its one
# backend, so this is a pure insertion, not a change to how any request ultimately gets resolved.
:443 {
	tls {
		on_demand
	}
	reverse_proxy localhost:6081
}

# Plain HTTP just redirects to HTTPS — Caddy still auto-handles the ACME HTTP-01 challenge path
# on :80 ahead of this (part of automatic HTTPS, not something this redir can shadow), so
# on_demand_tls above keeps working even though nothing here proxies to the supervisor directly.
:80 {
	redir https://{host}{uri} permanent
}
